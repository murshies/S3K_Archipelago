{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/murshies/S3K_Archipelago/apworld/player-config.schema.json",
    "title": "Schema for Sonic 3 & Knuckles Archipelago player configuration files",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "The player's name for the game. This must match the filename."
        },
        "game": {
            "type": "string",
            "description": "The name of the game. Must be 'Sonic 3 & Knuckles' for this game.",
            "enum": ["Sonic 3 & Knuckles"]
        },
        "description": {
            "type": "string",
            "description": "Description of this configuration",
            "default": "Sonic 3 & Knuckles Archipelago player configuration"
        },
        "Sonic 3 & Knuckles": {"$ref": "#/definitions/game_config"}
    },
    "required": ["name", "game", "Sonic 3 & Knuckles"],
    "definitions": {
        "goal": {
            "type": ["string", "null"],
            "enum": [
                "death_egg",
                "knuckles_sky_sanctuary",
                "doomsday"
            ]
        },
        "game_config": {
            "type": "object",
            "description": "Game settings",
            "additionalProperties": false,
            "properties": {
                "big_rings_goal": {"$ref": "#/definitions/goal"},
                "big_rings_to_check": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 77,
                    "default": 0
                },
                "chaos_emeralds_goal": {"$ref": "#/definitions/goal"},
                "super_emeralds_goal": {"$ref": "#/definitions/goal"},
                "death_link": {
                    "type": "boolean",
                    "default": false
                },
                "logic_difficulty": {
                    "type": "string",
                    "description": "The logic difficulty",
                    "default": "standard",
                    "enum": [
                        "standard",
                        "hard"
                    ]
                },
                "zone_unlocks": {
                    "type": "string",
                    "description": "Determines if/how zones and characters are unlocked.",
                    "default": "all_unlocked",
                    "enum": [
                        "all_unlocked",
                        "zones_and_characters",
                        "zones_only",
                        "characters_only"
                    ]
                },
                "traps_enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enables or disables traps"
                },
                "enable_bosses": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle minibosses and bosses as a location"
                },
                "enable_big_rings": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle big rings as a location"
                },
                "enable_special_stage_emeralds": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle special stage emeralds (completion of stage) as a location"
                },
                "enable_special_stage_perfects": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle getting a perfect in each special stage as a location"
                },
                "enable_lightning_shields": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle lightning shield item boxes as a location"
                },
                "enable_flame_shields": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle flame shield item boxes as a location"
                },
                "enable_water_shields": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle water shield item boxes as a location"
                },
                "enable_invincibility_item_boxes": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle invicibility item boxes as a location"
                },
                "enable_power_sneakers": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle power sneaker item boxes as a location"
                },
                "enable_1_ups": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle 1 up item boxes as a location"
                },
                "enable_super_rings": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle super ring item boxes (10 rings) as a location"
                },
                "enable_robotnik_item_boxes": {
                    "type": "boolean",
                    "default": false,
                    "description": "Toggle robotnik item boxes as a location"
                }
            }
        }
    }
}
